<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XeZa-Agent | Recon & Utility Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');
        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0a0a0a;
            color: #00ff66;
        }
        .brutal-border {
            border: 2px solid #00ff66;
            box-shadow: 4px 4px 0px #00ff66;
        }
        .brutal-btn {
            border: 2px solid #00ff66;
            background: #000;
            color: #00ff66;
            transition: all 0.1s ease;
        }
        .brutal-btn:hover {
            background: #00ff66;
            color: #000;
            box-shadow: 2px 2px 0px #fff;
        }
    </style>
</head>
<body class="p-4 md:p-8 min-h-screen flex flex-col justify-between">

    <header class="mb-8 brutal-border p-4 bg-black">
        <div class="flex justify-between items-center">
            <h1 class="text-2xl font-bold tracking-wider">[ XEZA-AGENT v1.0 ]</h1>
            <span class="text-xs bg-green-900 text-green-300 px-2 py-1 border border-green-500">SYSTEM ACTIVE</span>
        </div>
        <p class="text-xs text-gray-400 mt-2">Target Recon & Enumeration Dashboard</p>
    </header>

    <main class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="brutal-border p-6 bg-black flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold mb-4 text-white">> TARGET CONFIGURATION</h2>
                <label class="block text-xs text-gray-400 mb-2">TARGET URL / DOMAIN</label>
                <input type="text" id="targetUrl" placeholder="https://example.com" class="w-full bg-black border-2 border-green-500 p-3 text-green-400 mb-4 focus:outline-none">
                
                <label class="block text-xs text-gray-400 mb-2">SELECT MODULE</label>
                <select id="moduleSelect" class="w-full bg-black border-2 border-green-500 p-3 text-green-400 mb-6 focus:outline-none">
                    <option value="plugins">WordPress Common Plugins Check</option>
                    <option value="headers">Security Headers Analysis</option>
                    <option value="upload">Upload Directory Scanner</option>
                </select>
            </div>
            <button onclick="runScan()" class="brutal-btn w-full py-3 font-bold uppercase tracking-wider">Execute Operation</button>
        </div>

        <div class="brutal-border p-6 bg-black flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold text-white">> EXECUTION LOGS</h2>
                <button onclick="clearLogs()" class="text-xs text-gray-500 hover:text-green-400">[CLEAR]</button>
            </div>
            <div id="outputLog" class="w-full h-64 bg-black border border-green-800 p-4 overflow-y-auto text-xs text-green-400 space-y-2">
                <div>[System Ready. Waiting for target input...]</div>
            </div>
        </div>
    </main>

    <footer class="text-center text-xs text-gray-600 border-t border-gray-900 pt-4">
        XeZa-Agent // Built for High-Performance Recon
    </footer>

    <script>
        const commonPlugins = [
            "code-snippets", "contact-form-7", "advanced-custom-fields", 
            "advanced-woo-search", "elementor", "duplicate-page", "gtranslate"
        ];

        function log(message, type = "info") {
            const logBox = document.getElementById('outputLog');
            const colorClass = type === 'error' ? 'text-red-500' : type === 'success' ? 'text-green-300' : 'text-green-400';
            logBox.innerHTML += `<div class="${colorClass}">[${new Date().toLocaleTimeString()}] ${message}</div>`;
            logBox.scrollTop = logBox.scrollHeight;
        }

        function clearLogs() {
            document.getElementById('outputLog').innerHTML = '<div>[Logs cleared.]</div>';
        }

        async function runScan() {
            const rawUrl = document.getElementById('targetUrl').value.trim();
            const module = document.getElementById('moduleSelect').value;

            if (!rawUrl) {
                log("Error: Target URL cannot be empty.", "error");
                return;
            }

            let target = rawUrl.endsWith('/') ? rawUrl.slice(0, -1) : rawUrl;
            log(`Initializing module [${module}] on target: ${target}`);

            if (module === 'plugins') {
                log("Generating plugin paths for enumeration...");
                commonPlugins.forEach(plugin => {
                    const checkUrl = `${target}/wp-content/plugins/${plugin}/readme.txt`;
                    log(`[*] Checking path: ${checkUrl}`);
                });
            } else if (module === 'headers') {
                log(`Analyzing target security posture for ${target}...`);
                log(`[+] Target queued for header analysis check.`, "success");
            } else if (module === 'upload') {
                log(`Scanning standard upload directories...`);
                const uploadPaths = [
                    `${target}/wp-content/uploads/`,
                    `${target}/wp-content/plugins/restrict-wp-upload-type/`
                ];
                uploadPaths.forEach(p => log(`[*] Probing: ${p}`));
            }
        }
    </script>
</body>
</html>
